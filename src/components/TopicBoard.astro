---
import type { CollectionEntry } from "astro:content";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";

type Props = { posts: CollectionEntry<"posts">[] };
type TopicTag = {
  slug: string;
  name: string;
  topic: CollectionEntry<"posts">["data"]["tags"][number];
};

const { posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const categoryPosts = posts.filter(post => !post.data.hideFromCategories);
const definitions: { slug: string; name: string; tags: TopicTag[] }[] = [
  {
    slug: "development",
    name: "개발",
    tags: [
      { slug: "operations", name: "운영", topic: "Operations" },
      { slug: "platform", name: "플랫폼", topic: "Platform" },
      { slug: "product", name: "제품", topic: "Product" },
      { slug: "study", name: "학습", topic: "Study" },
    ],
  },
  {
    slug: "review",
    name: "회고",
    tags: [
      { slug: "weekly-review", name: "주간 회고", topic: "Weekly Review" },
      { slug: "annual-review", name: "연간 회고", topic: "Annual Review" },
    ],
  },
  {
    slug: "ai",
    name: "AI",
    tags: [
      { slug: "features", name: "AI 기능 개발", topic: "AI" },
      { slug: "ax", name: "AX · 업무 자동화", topic: "AI" },
    ],
  },
];

const groups = definitions.map(group => {
  const entries = categoryPosts.flatMap(post => {
    const tag = group.tags.find(
      tag =>
        post.data.tags[0] === tag.topic &&
        (tag.topic !== "AI" ||
          tag.slug === (post.data.aiCategory ?? "features"))
    );
    return tag ? [{ post, tag }] : [];
  });
  return {
    ...group,
    entries,
    filters: [
      { slug: "all", name: "전체", count: entries.length },
      ...group.tags.map(tag => ({
        ...tag,
        count: entries.filter(entry => entry.tag.slug === tag.slug).length,
      })),
    ],
  };
});

const dateFormatter = new Intl.DateTimeFormat("ko-KR", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: config.site.timezone,
});
---

<section
  id="topics"
  data-topic-board
  class="relative left-1/2 w-[calc(100vw-2rem)] max-w-7xl -translate-x-1/2 pt-5 pb-2"
>
  <div class="mb-5">
    <h1 class="text-2xl font-semibold tracking-wide">Posts</h1>
    <p class="text-muted-foreground mt-1 text-sm">
      관심 있는 주제를 고르고, 태그로 글을 찾아보세요.
    </p>
  </div>

  <div
    role="tablist"
    aria-label="글 주제"
    class="border-border mb-5 flex gap-2 border-b"
  >
    {
      groups.map((group, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${group.slug}`}
          data-topic-tab={group.slug}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`panel-${group.slug}`}
          tabindex={index === 0 ? 0 : -1}
          class="text-muted-foreground hover:text-foreground -mb-px inline-flex items-center gap-2 border-b-2 border-transparent px-4 py-3 text-base font-semibold transition-colors"
        >
          {group.name}
          <span class="text-xs font-normal opacity-70">
            {group.entries.length}
          </span>
        </button>
      ))
    }
  </div>

  <p data-filter-status class="sr-only" aria-live="polite" aria-atomic="true">
    {groups[0].name} 전체 글 {groups[0].entries.length}개
  </p>

  {
    groups.map((group, index) => (
      <section
        role="tabpanel"
        id={`panel-${group.slug}`}
        aria-labelledby={`tab-${group.slug}`}
        data-topic-panel={group.slug}
        data-topic-name={group.name}
        tabindex="0"
        hidden={index !== 0}
      >
        <nav
          aria-label={`${group.name} 세부 태그`}
          class="mb-5 flex flex-wrap gap-2"
        >
          {group.filters.map(filter => (
            <button
              type="button"
              data-tag-filter={filter.slug}
              data-tag-name={filter.name}
              aria-pressed={filter.slug === "all" ? "true" : "false"}
              class="border-border hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors"
            >
              {filter.name}
              <span data-filter-count class="text-xs opacity-70">
                {filter.count}
              </span>
            </button>
          ))}
        </nav>

        <div data-post-grid class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {group.entries.map(({ post, tag }) => (
            <article
              data-post-card
              data-post-tag={tag.slug}
              class="border-border bg-background hover:border-accent/60 focus-within:border-accent group min-h-56 rounded-xl border transition-colors"
            >
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                class="flex min-h-56 w-full flex-col p-4 no-underline"
                aria-label={`${post.data.title} 글 읽기`}
              >
                <div class="mb-3 flex items-center justify-between gap-3">
                  <span class="bg-muted rounded-full px-2.5 py-1 text-xs font-medium">
                    {tag.name}
                  </span>
                  <time
                    datetime={post.data.pubDatetime.toISOString()}
                    class="text-muted-foreground text-xs whitespace-nowrap"
                  >
                    {dateFormatter.format(post.data.pubDatetime)}
                  </time>
                </div>
                <h2 class="group-hover:text-accent mb-2 text-base leading-6 font-semibold transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-muted-foreground line-clamp-2 text-sm leading-6">
                  {post.data.description}
                </p>
                <span class="text-accent mt-auto pt-4 text-sm font-medium">
                  읽어보기 →
                </span>
              </a>
            </article>
          ))}
        </div>
        <p
          data-empty-state
          hidden={group.entries.length > 0}
          class="text-muted-foreground border-border rounded-xl border border-dashed px-4 py-12 text-center text-sm"
        >
          아직 이 태그에 등록된 글이 없습니다.
        </p>
      </section>
    ))
  }
</section>

<script>
  let controller: AbortController | undefined;

  function initializeTopicFilter() {
    controller?.abort();
    const board = document.querySelector<HTMLElement>("[data-topic-board]");
    if (!board) return;

    controller = new AbortController();
    const { signal } = controller;
    const tabs = Array.from(
      board.querySelectorAll<HTMLButtonElement>("[data-topic-tab]")
    );
    const panels = Array.from(
      board.querySelectorAll<HTMLElement>("[data-topic-panel]")
    );
    const status = board.querySelector<HTMLElement>("[data-filter-status]");

    function select(topic: string, tag: string, updateUrl = true) {
      const panel =
        panels.find(panel => panel.dataset.topicPanel === topic) ?? panels[0];
      if (!panel) return;

      const selectedTopic = panel.dataset.topicPanel!;
      const filters = Array.from(
        panel.querySelectorAll<HTMLButtonElement>("[data-tag-filter]")
      );
      const selectedFilter =
        filters.find(filter => filter.dataset.tagFilter === tag) ?? filters[0];
      const selectedTag = selectedFilter.dataset.tagFilter!;

      panels.forEach(item => (item.hidden = item !== panel));
      tabs.forEach(tab => {
        const selected = tab.dataset.topicTab === selectedTopic;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      filters.forEach(filter =>
        filter.setAttribute("aria-pressed", String(filter === selectedFilter))
      );

      let count = 0;
      panel.querySelectorAll<HTMLElement>("[data-post-card]").forEach(card => {
        card.hidden =
          selectedTag !== "all" && card.dataset.postTag !== selectedTag;
        if (!card.hidden) count++;
      });
      const emptyState = panel.querySelector<HTMLElement>("[data-empty-state]");
      if (emptyState) emptyState.hidden = count > 0;
      if (status) {
        status.textContent = `${panel.dataset.topicName} ${selectedFilter.dataset.tagName} 글 ${count}개`;
      }

      const url = new URL(window.location.href);
      if (updateUrl) {
        url.searchParams.set("tab", selectedTopic);
        if (selectedTag === "all") url.searchParams.delete("tag");
        else url.searchParams.set("tag", selectedTag);
        window.history.replaceState(window.history.state, "", url);
      }
      try {
        sessionStorage.setItem("backUrl", url.pathname + url.search + url.hash);
      } catch {
        // Filtering still works when browser storage is unavailable.
      }
    }

    function restoreSelection() {
      const params = new URL(window.location.href).searchParams;
      select(
        params.get("tab") ?? panels[0]?.dataset.topicPanel ?? "development",
        params.get("tag") ?? "all",
        false
      );
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener(
        "click",
        () => select(tab.dataset.topicTab!, "all"),
        { signal }
      );
      tab.addEventListener(
        "keydown",
        event => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
          else if (event.key === "ArrowLeft")
            next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else return;
          event.preventDefault();
          tabs[next].focus();
          select(tabs[next].dataset.topicTab!, "all");
        },
        { signal }
      );
    });
    panels.forEach(panel => {
      panel
        .querySelectorAll<HTMLButtonElement>("[data-tag-filter]")
        .forEach(filter => {
          filter.addEventListener(
            "click",
            () => select(panel.dataset.topicPanel!, filter.dataset.tagFilter!),
            { signal }
          );
        });
    });
    window.addEventListener("popstate", restoreSelection, { signal });
    restoreSelection();
  }

  document.addEventListener("astro:page-load", initializeTopicFilter);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>

<style>
  [data-topic-tab][aria-selected="true"] {
    border-color: var(--foreground);
    color: var(--foreground);
  }

  [data-tag-filter][aria-pressed="true"] {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--background);
  }
</style>
